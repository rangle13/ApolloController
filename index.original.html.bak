<!-- ====================== PAGE 6: SEGMENTS ====================== -->
<div id="page-segments" class="page">
  <h2 style="font-size:20px;font-weight:700;margin-bottom:16px;">Segment Designer</h2>
  <div style="display:flex;gap:16px;flex-wrap:wrap;">

    <!-- Sidebar Layers -->
    <div style="width:220px;flex-shrink:0;">
      <div class="acard" style="min-height:300px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <h4 style="font-size:14px;font-weight:700;">Segments</h4>
          <button class="abtn abtn-amber abtn-sm" id="seg-add-btn">＋ Add</button>
        </div>
        <div id="seg-layer-list" style="display:flex;flex-direction:column;gap:4px;">
          <p style="font-size:12px;color:var(--muted);text-align:center;padding:20px 0;" id="seg-no-items">No segments yet</p>
        </div>
      </div>
    </div>

    <!-- Canvas -->
    <div style="flex:1;min-width:300px;">
      <div class="acard" style="padding:8px;">
        <div style="width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px 0 8px;">
          <div id="seg-device-title" style="font-size:15px;font-weight:700;color:var(--amber);line-height:1.2;">M1</div>
          <div id="seg-canvas-label" style="font-size:11px;color:var(--muted);margin-top:2px;">64×64</div>
        </div>
        <div id="seg-canvas" style="position:relative;width:100%;aspect-ratio:1;background:#0a0a0f;border:1px solid var(--border);border-radius:6px;overflow:hidden;cursor:crosshair;">
          <div id="seg-coord-pill" style="position:absolute;top:6px;right:6px;z-index:20;background:rgba(0,0,0,0.8);color:var(--amber);font-family:monospace;font-size:11px;padding:3px 8px;border-radius:4px;pointer-events:none;">X: —  Y: —</div>
        </div>
        <p id="seg-status-bar" style="font-size:11px;font-family:monospace;color:var(--amber);margin-top:4px;text-align:center;">No segment selected — click a segment to select</p>
      </div>
      <div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;">
        <button class="abtn abtn-amber" id="seg-apply-btn">Push Segments to Device</button>
        <button class="abtn abtn-ghost" id="seg-fetch-btn">Fetch from Device</button>
        <button class="abtn abtn-ghost" id="seg-reset-btn">Reset All</button>
      </div>
    </div>

    <!-- Properties -->
    <div style="width:260px;flex-shrink:0;">
      <div class="acard" style="min-height:300px;" id="seg-props-panel">
        <h4 style="font-size:14px;font-weight:700;margin-bottom:10px;">Segment Properties</h4>
        <div id="seg-props-empty" style="text-align:center;padding:30px 0;">
          <p style="font-size:13px;color:var(--muted);">No segment selected</p>
        </div>
        <div id="seg-props-form" style="display:none;">
          <div style="margin-bottom:8px;">
            <label style="font-size:12px;color:var(--muted);">Name</label>
            <input type="text" id="sp-name" style="font-size:13px;" />
          </div>
          <div style="margin-bottom:8px;display:flex;align-items:center;gap:8px;">
            <label style="font-size:12px;color:var(--muted);">Color</label>
            <input type="color" id="sp-color" value="#6366f1" />
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px;">
            <div><label style="font-size:11px;color:var(--muted);">X Start</label><input type="number" id="sp-x1" min="0" style="font-size:12px;" /></div>
            <div><label style="font-size:11px;color:var(--muted);">X Stop</label><input type="number" id="sp-x2" min="1" style="font-size:12px;" /></div>
            <div><label style="font-size:11px;color:var(--muted);">Y Start</label><input type="number" id="sp-y1" min="0" style="font-size:12px;" /></div>
            <div><label style="font-size:11px;color:var(--muted);">Y Stop</label><input type="number" id="sp-y2" min="1" style="font-size:12px;" /></div>
          </div>
          <hr style="border-color:var(--border);margin:10px 0;" />
          <p style="font-size:11px;color:var(--muted);margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">WLED Effect</p>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Effect (fx)</label>
            <select id="sp-fx" style="font-size:13px;">
              <option value="0">0 – Solid</option>
              <option value="1">1 – Blink</option>
              <option value="2">2 – Breathe</option>
              <option value="3">3 – Wipe</option>
              <option value="4">4 – Wipe Random</option>
              <option value="5">5 – Random Colors</option>
              <option value="6">6 – Sweep</option>
              <option value="7">7 – Dynamic</option>
              <option value="8">8 – Colorloop</option>
              <option value="9">9 – Rainbow</option>
              <option value="10">10 – Scan</option>
              <option value="11">11 – Dual Scan</option>
              <option value="12">12 – Fade</option>
              <option value="13">13 – Chase</option>
              <option value="14">14 – Chase Random</option>
              <option value="16">16 – Chase Flash</option>
              <option value="18">18 – Rainbow Runner</option>
              <option value="24">24 – Stream</option>
              <option value="25">25 – Scanner</option>
              <option value="27">27 – Fireworks</option>
              <option value="28">28 – Rain</option>
              <option value="30">30 – Fire Flicker</option>
              <option value="31">31 – Gradient</option>
              <option value="41">41 – Fairy</option>
              <option value="45">45 – Halloween</option>
              <option value="49">49 – Lightning</option>
              <option value="54">54 – Oscillate</option>
              <option value="55">55 – Pride 2015</option>
              <option value="56">56 – Juggle</option>
              <option value="57">57 – Palette</option>
              <option value="58">58 – Fire 2012</option>
              <option value="59">59 – Colorwaves</option>
              <option value="60">60 – BPM</option>
              <option value="61">61 – Lake</option>
              <option value="62">62 – Meteor</option>
              <option value="63">63 – Meteor Smooth</option>
              <option value="71">71 – Ripple</option>
              <option value="72">72 – Twinklefox</option>
              <option value="80">80 – Candle</option>
              <option value="81">81 – Fireworks Starburst</option>
              <option value="83">83 – Bouncing Balls</option>
              <option value="84">84 – Sinelon</option>
              <option value="87">87 – Popcorn</option>
              <option value="88">88 – Drip</option>
              <option value="89">89 – Plasma</option>
              <option value="91">91 – Ripple Rainbow</option>
              <option value="92">92 – Heartbeat</option>
              <option value="93">93 – Pacifica</option>
              <option value="94">94 – Candle Multi</option>
              <option value="96">96 – Sunrise</option>
              <option value="100">100 – Sine</option>
              <option value="102">102 – Flow</option>
              <option value="104">104 – Dancing Shadows</option>
              <option value="105">105 – Washing Machine</option>
            </select>
          </div>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Palette (pal)</label>
            <select id="sp-pal" style="font-size:13px;">
              <option value="0">0 – Default</option>
              <option value="1">1 – Random</option>
              <option value="2">2 – Primary</option>
              <option value="6">6 – Party</option>
              <option value="7">7 – Cloud</option>
              <option value="8">8 – Lava</option>
              <option value="9">9 – Ocean</option>
              <option value="10">10 – Forest</option>
              <option value="11">11 – Rainbow</option>
              <option value="35">35 – Fire</option>
            </select>
          </div>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Brightness <span id="sp-bri-val">200</span></label>
            <input type="range" id="sp-bri" min="0" max="255" value="200" />
          </div>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Speed <span id="sp-sx-val">128</span></label>
            <input type="range" id="sp-sx" min="0" max="255" value="128" />
          </div>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Intensity <span id="sp-ix-val">128</span></label>
            <input type="range" id="sp-ix" min="0" max="255" value="128" />
          </div>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Primary Color</label>
            <input type="color" id="sp-col1" value="#ff0000" />
          </div>
          <div style="margin-bottom:6px;">
            <label style="font-size:12px;color:var(--muted);">Secondary Color</label>
            <input type="color" id="sp-col2" value="#00ff00" />
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:12px;color:var(--muted);">Tertiary Color</label>
            <input type="color" id="sp-col3" value="#0000ff" />
          </div>
          <div style="margin-bottom:8px;display:flex;align-items:center;gap:8px;">
            <input type="checkbox" id="sp-on" style="width:auto;" checked />
            <label for="sp-on" style="font-size:12px;">Segment On</label>
          </div>
          <div style="margin-bottom:10px;display:flex;align-items:center;gap:8px;">
            <input type="checkbox" id="sp-rev" style="width:auto;" />
            <label for="sp-rev" style="font-size:12px;">Reverse</label>
          </div>
          <div style="margin-bottom:8px;">
            <label style="font-size:12px;color:var(--muted);">Blend Mode (mi)</label>
            <select id="sp-mi" style="font-size:13px;">
              <option value="0">0 – Normal (default)</option>
              <option value="1">1 – Add</option>
              <option value="2">2 – Subtract</option>
              <option value="3">3 – Multiply</option>
              <option value="4">4 – Screen</option>
              <option value="5">5 – Overlay</option>
              <option value="6">6 – Dodge</option>
              <option value="7">7 – Burn</option>
              <option value="8">8 – Lighten</option>
              <option value="9">9 – Darken</option>
              <option value="10">10 – Difference</option>
              <option value="11">11 – Exclusion</option>
              <option value="12">12 – Hard Light</option>
              <option value="13">13 – Soft Light</option>
            </select>
          </div>
          <button class="abtn abtn-ghost abtn-sm" id="sp-json-btn" style="width:100%;margin-bottom:6px;">JSON Preview</button>
          <pre id="sp-json-pre" style="display:none;font-size:11px;background:var(--bg);padding:8px;border-radius:6px;margin-bottom:8px;overflow:auto;max-height:140px;color:var(--amber);"></pre>
          <button class="abtn abtn-danger abtn-sm" id="sp-delete-btn" style="width:100%;">Delete Segment</button>
        </div>
      </div>
    </div>
  </div>
</div>

</main>

<footer data-id="289" style="text-align:center;padding:20px;font-size:12px;color:var(--muted);border-top:1px solid var(--border);margin-top:40px;">
  Made by Copilot
</footer>
<script src="/js/app.js"></script>
<script src="/js/dashboard.js"></script>
<script src="/js/textdelay.js"></script>
<script src="/js/overlay.js"></script>
<script src="/js/devices.js"></script>
<script src="/js/playlist.js"></script>
<script src="/js/segments.js"></script>
</body>
</html>
