<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="dark" />
<title>Apollo M-1 WLED Controller</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        bg: '#0f1117', card: '#1a1d27', border: '#2a2d3a',
        amber: '#f59e0b', indigo: '#6366f1', txt: '#f1f5f9',
        muted: '#64748b', success: '#22c55e', danger: '#ef4444',
      }
    }
  }
};
</script>
<script src="https://unpkg.com/lucide@latest" defer></script>
<link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
<app-icon data-id="1" hidden data-icon="sun" data-palette="Yellow"></app-icon>

<!-- NAVBAR -->
<nav data-id="2" id="navbar-abc1" style="position:fixed;top:0;left:0;right:0;height:56px;background:var(--bg);border-bottom:1px solid var(--border);z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 16px;">
  <div data-id="3" style="display:flex;align-items:center;gap:8px;">
    <span data-id="4" style="width:10px;height:10px;border-radius:50%;background:var(--amber);display:inline-block;"></span>
    <span data-id="5" style="font-weight:700;font-size:16px;color:#fff;">Apollo M-1</span>
  </div>
  <div data-id="6" class="mobile-nav-scroll" style="gap:0;flex:1;overflow-x:auto;">
    <button data-id="7" class="nav-tab active" data-nav="dashboard">Dashboard</button>
    <button data-id="8" class="nav-tab" data-nav="textdelay">Text Delay</button>
    <button data-id="9" class="nav-tab" data-nav="overlay">Overlay</button>
    <button data-id="10" class="nav-tab" data-nav="devices">Devices</button>
    <button data-id="11" class="nav-tab" data-nav="playlist">Playlist</button>
    <button class="nav-tab" data-nav="segments" style="color:#818cf8;">Segments ⊞</button>
  </div>
</nav>

<main data-id="12" style="padding-top:60px;">

<!-- ====================== PAGE 1: DASHBOARD ====================== -->
<div data-id="13" id="page-dashboard" class="page active">

  <!-- Connection Card -->
  <div data-id="14" class="acard" style="margin-bottom:16px;">
    <div data-id="15" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;">
      <label data-id="16" style="font-size:13px;font-weight:600;white-space:nowrap;">Apollo M-1 Device IP:</label>
      <input data-id="17" type="text" id="ip-input-d1a2" placeholder="e.g. 192.168.1.45" style="flex:1;min-width:160px;" />
      <select data-id="18" id="saved-device-dd-x1b3" style="width:auto;min-width:140px;">
        <option data-id="19" value="">Or use saved device…</option>
      </select>
      <button data-id="20" class="abtn abtn-amber" id="connect-btn-c3d4">Connect</button>
    </div>
    <div data-id="21" style="margin-top:10px;">
      <span data-id="22" class="status-pill" id="conn-status-e5f6">
        <span data-id="23" class="status-dot" style="background:var(--muted);"></span>
        <span data-id="24" id="conn-label-g7h8">Disconnected</span>
      </span>
    </div>
  </div>

  <!-- Master Controls -->
  <div data-id="25" class="acard" style="margin-bottom:16px;">
    <h3 data-id="26" style="font-size:15px;font-weight:700;margin-bottom:12px;">Master Controls</h3>
    <div data-id="27" style="display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between;">
      <div data-id="28" style="display:flex;align-items:center;gap:10px;">
        <span data-id="29" style="font-size:13px;color:var(--muted);">OFF</span>
        <input data-id="30" type="checkbox" id="power-toggle-i9j0" class="toggle-input" />
        <label data-id="31" for="power-toggle-i9j0" class="toggle-track" id="power-label-k1l2"></label>
        <span data-id="32" style="font-size:13px;color:var(--muted);">ON</span>
      </div>
      <div data-id="33" style="display:flex;align-items:center;gap:10px;flex:1;min-width:180px;max-width:400px;">
        <label data-id="34" style="font-size:13px;font-weight:600;white-space:nowrap;">Brightness</label>
        <input data-id="35" type="range" id="bri-slider-m3n4" min="0" max="255" value="200" />
        <span data-id="36" id="bri-val-o5p6" style="font-size:13px;font-weight:600;min-width:28px;text-align:right;">200</span>
      </div>
      <button data-id="37" class="abtn abtn-danger" id="alloff-btn-q7r8">All Off</button>
    </div>
  </div>

  <!-- Quick Presets -->
  <div data-id="38" class="acard" style="margin-bottom:16px;">
    <h3 data-id="39" style="font-size:15px;font-weight:700;margin-bottom:12px;">Quick Presets</h3>
    <select data-id="40" id="preset-sel-s9t0" style="margin-bottom:8px;"></select>
    <p data-id="41" id="preset-desc-u1v2" style="font-size:13px;color:var(--muted);margin-bottom:12px;min-height:20px;"></p>
    <button data-id="42" class="abtn abtn-amber" id="apply-preset-w3x4">Apply Preset</button>
  </div>

  <!-- Overlay Presets -->
  <div data-id="43" class="acard" style="margin-bottom:16px;">
    <h3 data-id="44" style="font-size:15px;font-weight:700;margin-bottom:12px;">Overlay Presets</h3>
    <select data-id="45" id="overlay-preset-sel-y5z6" style="margin-bottom:8px;"></select>
    <p data-id="46" id="overlay-preset-desc-a7b8" style="font-size:13px;color:var(--muted);margin-bottom:12px;min-height:20px;"></p>
    <button data-id="47" class="abtn abtn-amber" id="apply-overlay-preset-c9d0">Apply Overlay</button>
  </div>

  <!-- Active Playlist -->
  <div data-id="48" class="acard" style="margin-bottom:16px;">
    <h3 data-id="49" style="font-size:15px;font-weight:700;margin-bottom:10px;">Active Playlist</h3>
    <p data-id="50" id="active-pl-label-e1f2" style="font-size:13px;color:var(--muted);margin-bottom:10px;">No playlist playing</p>
    <div data-id="51" style="display:flex;gap:8px;align-items:center;">
      <button data-id="52" class="abtn abtn-amber abtn-sm" id="dash-pl-play-g3h4">▶ Play</button>
      <button data-id="53" class="abtn abtn-danger abtn-sm" id="dash-pl-stop-i5j6">⏹ Stop</button>
      <button data-id="54" class="abtn abtn-ghost abtn-sm" id="dash-pl-manage-k7l8" style="margin-left:auto;">Manage →</button>
    </div>
  </div>

  <!-- Bottom Nav Cards -->
  <div data-id="55" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;">
    <div data-id="56" class="acard" style="display:flex;flex-direction:column;gap:8px;">
      <div data-id="57" style="display:flex;align-items:center;gap:8px;">
        <i data-id="58" data-lucide="type" class="w-5 h-5" style="color:var(--amber);"></i>
        <h4 data-id="59" style="font-size:14px;font-weight:700;">Text Delay</h4>
      </div>
      <p data-id="60" style="font-size:13px;color:var(--muted);">Send timed text sequences to LED bands</p>
      <button data-id="61" class="abtn abtn-amber abtn-sm" id="goto-textdelay-m9n0" style="align-self:flex-start;">Open →</button>
    </div>
    <div data-id="62" class="acard" style="display:flex;flex-direction:column;gap:8px;">
      <div data-id="63" style="display:flex;align-items:center;gap:8px;">
        <i data-id="64" data-lucide="layers" class="w-5 h-5" style="color:var(--amber);"></i>
        <h4 data-id="65" style="font-size:14px;font-weight:700;">Overlay</h4>
      </div>
      <p data-id="66" style="font-size:13px;color:var(--muted);">Design matrix overlay zones visually</p>
      <button data-id="67" class="abtn abtn-amber abtn-sm" id="goto-overlay-o1p2" style="align-self:flex-start;">Open →</button>
    </div>
    <div class="acard" style="display:flex;flex-direction:column;gap:8px;border-left:3px solid #6366f1;">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:18px;">⊞</span>
        <h4 style="font-size:14px;font-weight:700;">Segment Designer</h4>
      </div>
      <p style="font-size:13px;color:var(--muted);">Draw and configure WLED segments visually on the matrix grid</p>
      <button class="abtn abtn-indigo abtn-sm" id="goto-segments-btn" style="align-self:flex-start;">Open →</button>
    </div>
  </div>
</div>

<!-- ====================== PAGE 2: TEXT DELAY ====================== -->
<div data-id="68" id="page-textdelay" class="page">
  <h2 data-id="69" style="font-size:20px;font-weight:700;margin-bottom:4px;">Text Delay Sequencer</h2>
  <p data-id="70" style="font-size:13px;color:var(--muted);margin-bottom:16px;">Send timed text to Band 1 and Band 2</p>

  <div data-id="71" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-bottom:16px;">
    <!-- Band 1 -->
    <div data-id="72" class="acard" style="border-left:3px solid var(--amber);">
      <span data-id="73" style="display:inline-block;background:var(--amber);color:#000;font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;margin-bottom:10px;">BAND 1</span>
      <div data-id="74" style="margin-bottom:10px;">
        <div data-id="75" style="display:flex;justify-content:space-between;margin-bottom:4px;"><label data-id="76" style="font-size:13px;font-weight:600;">Line 1</label><span data-id="77" id="b1l1-count-q3r4" style="font-size:11px;color:var(--muted);">0/255</span></div>
        <input data-id="78" type="text" id="b1l1-s5t6" placeholder="First line of text..." maxlength="255" />
      </div>
      <div data-id="79" style="margin-bottom:10px;">
        <div data-id="80" style="display:flex;justify-content:space-between;margin-bottom:4px;"><label data-id="81" style="font-size:13px;font-weight:600;">Line 2</label><span data-id="82" id="b1l2-count-u7v8" style="font-size:11px;color:var(--muted);">0/255</span></div>
        <input data-id="83" type="text" id="b1l2-w9x0" placeholder="Second line of text..." maxlength="255" />
      </div>
      <div data-id="84">
        <label data-id="85" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;">Delay (ms)</label>
        <input data-id="86" type="number" id="b1delay-y1z2" value="2000" min="100" max="30000" step="100" />
        <span data-id="87" style="font-size:11px;color:var(--muted);">Time between lines</span>
      </div>
    </div>
    <!-- Band 2 -->
    <div data-id="88" class="acard" style="border-left:3px solid var(--indigo);">
      <span data-id="89" style="display:inline-block;background:var(--indigo);color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;margin-bottom:10px;">BAND 2</span>
      <div data-id="90" style="margin-bottom:10px;">
        <div data-id="91" style="display:flex;justify-content:space-between;margin-bottom:4px;"><label data-id="92" style="font-size:13px;font-weight:600;">Line 1</label><span data-id="93" id="b2l1-count-a3b4" style="font-size:11px;color:var(--muted);">0/255</span></div>
        <input data-id="94" type="text" id="b2l1-c5d6" placeholder="First line of text..." maxlength="255" />
      </div>
      <div data-id="95" style="margin-bottom:10px;">
        <div data-id="96" style="display:flex;justify-content:space-between;margin-bottom:4px;"><label data-id="97" style="font-size:13px;font-weight:600;">Line 2</label><span data-id="98" id="b2l2-count-e7f8" style="font-size:11px;color:var(--muted);">0/255</span></div>
        <input data-id="99" type="text" id="b2l2-g9h0" placeholder="Second line of text..." maxlength="255" />
      </div>
      <div data-id="100">
        <label data-id="101" style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;">Delay (ms)</label>
        <input data-id="102" type="number" id="b2delay-i1j2" value="2000" min="100" max="30000" step="100" />
        <span data-id="103" style="font-size:11px;color:var(--muted);">Time between lines</span>
      </div>
    </div>
  </div>

  <!-- Run Controls -->
  <div data-id="104" class="acard">
    <div data-id="105" style="display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap;">
      <button data-id="106" class="abtn abtn-amber" id="seq-run-k3l4" style="min-width:160px;">▶ Run Sequence</button>
      <button data-id="107" class="abtn abtn-danger" id="seq-stop-m5n6" style="display:none;">⏹ Stop</button>
    </div>
    <div data-id="108" style="background:var(--bg);border-radius:6px;height:8px;overflow:hidden;margin-bottom:8px;">
      <div data-id="109" id="seq-progress-o7p8" style="height:100%;width:0%;background:var(--amber);transition:width 0.3s;border-radius:6px;"></div>
    </div>
    <p data-id="110" id="seq-step-label-q9r0" style="font-size:13px;color:var(--muted);margin-bottom:10px;">Ready</p>
    <div data-id="111" id="seq-log-s1t2" class="log-area"></div>
  </div>
</div>

<!-- ====================== PAGE 3: OVERLAY ====================== -->
<div data-id="112" id="page-overlay" class="page">
  <h2 data-id="113" style="font-size:20px;font-weight:700;margin-bottom:16px;">Overlay Builder</h2>
  <div data-id="114" style="display:flex;gap:16px;flex-wrap:wrap;">
    <!-- Sidebar Layers -->
    <div data-id="115" style="width:220px;flex-shrink:0;">
      <div data-id="116" class="acard" style="min-height:300px;">
        <div data-id="117" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <h4 data-id="118" style="font-size:14px;font-weight:700;">Layers</h4>
          <button data-id="119" class="abtn abtn-amber abtn-sm" id="add-box-u3v4">＋ Add Box</button>
        </div>
        <div data-id="120" id="layer-list-w5x6" style="display:flex;flex-direction:column;gap:4px;">
          <p data-id="121" style="font-size:12px;color:var(--muted);text-align:center;padding:20px 0;" id="no-boxes-y7z8">No boxes yet</p>
        </div>
      </div>
    </div>

    <!-- Canvas Area -->
    <div data-id="122" style="flex:1;min-width:300px;">
      <div data-id="123" class="acard" style="padding:8px;">
        <div style="width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px 0 8px;">
          <div id="overlay-device-title" style="font-size:15px;font-weight:700;color:var(--amber);line-height:1.2;">M1</div>
          <div id="canvas-matrix-name-a1b2" style="font-size:11px;color:var(--muted);margin-top:2px;">64×64</div>
        </div>
        <div id="overlay-canvas-c3d4" style="position:relative;width:100%;aspect-ratio:1;background:#0a0a0f;border:1px solid var(--border);border-radius:6px;overflow:hidden;cursor:crosshair;">
          <div id="coord-pill-e5f6" style="position:absolute;top:6px;right:6px;z-index:20;background:rgba(0,0,0,0.8);color:var(--amber);font-family:monospace;font-size:11px;padding:3px 8px;border-radius:4px;pointer-events:none;">X: —  Y: —</div>
        </div>
        <p id="canvas-status-g7h8" style="font-size:11px;font-family:monospace;color:var(--amber);margin-top:4px;text-align:center;">No box selected — click a box to select</p>
      </div>
      <div data-id="131" style="display:flex;gap:10px;margin-top:12px;">
        <button data-id="132" class="abtn abtn-amber" id="apply-matrix-i9j0">Apply to Matrix</button>
        <button class="abtn abtn-ghost" id="overlay-fetch-btn">Fetch from Device</button>
        <button data-id="133" class="abtn abtn-ghost" id="reset-boxes-k1l2">Reset All</button>
      </div>
    </div>

    <!-- Properties Panel -->
    <div data-id="134" style="width:240px;flex-shrink:0;">
      <div data-id="135" class="acard" style="min-height:300px;" id="props-panel-m3n4">
        <h4 data-id="136" style="font-size:14px;font-weight:700;margin-bottom:10px;">Properties</h4>
        <div data-id="137" id="props-empty-o5p6">
          <p data-id="138" style="font-size:13px;color:var(--muted);text-align:center;padding:30px 0;">No box selected</p>
        </div>
        <div data-id="139" id="props-form-q7r8" style="display:none;">
          <div data-id="140" style="margin-bottom:8px;"><label data-id="141" style="font-size:12px;color:var(--muted);">Name</label><input data-id="142" type="text" id="prop-name-s9t0" style="font-size:13px;" /></div>
          <div data-id="143" style="margin-bottom:8px;display:flex;align-items:center;gap:8px;"><label data-id="144" style="font-size:12px;color:var(--muted);">Color</label><input data-id="145" type="color" id="prop-color-u1v2" value="#f59e0b" /></div>
          <div data-id="146" style="margin-bottom:8px;"><label data-id="147" style="font-size:12px;color:var(--muted);">Opacity</label><div data-id="148" style="display:flex;gap:6px;align-items:center;"><input data-id="149" type="range" id="prop-opacity-w3x4" min="10" max="100" value="60" /><span data-id="150" id="prop-opacity-val-y5z6" style="font-size:12px;min-width:32px;">60%</span></div></div>
          <div data-id="151" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px;">
            <div data-id="152"><label data-id="153" style="font-size:11px;color:var(--muted);">X Start</label><input data-id="154" type="number" id="prop-x1-a7b8" min="0" style="font-size:12px;" /></div>
            <div data-id="155"><label data-id="156" style="font-size:11px;color:var(--muted);">X Stop</label><input data-id="157" type="number" id="prop-x2-c9d0" min="1" style="font-size:12px;" /></div>
            <div data-id="158"><label data-id="159" style="font-size:11px;color:var(--muted);">Y Start</label><input data-id="160" type="number" id="prop-y1-e1f2" min="0" style="font-size:12px;" /></div>
            <div data-id="161"><label data-id="162" style="font-size:11px;color:var(--muted);">Y Stop</label><input data-id="163" type="number" id="prop-y2-g3h4" min="1" style="font-size:12px;" /></div>
          </div>
          <div data-id="164" style="margin-bottom:10px;"><label data-id="165" style="font-size:12px;color:var(--muted);">Effect</label><select id="prop-effect-i5j6" style="font-size:13px;">
  <option value="0">0 – Solid</option>
  <option value="1">1 – Blink</option>
  <option value="2">2 – Breathe</option>
  <option value="3">3 – Wipe</option>
  <option value="4">4 – Wipe Random</option>
  <option value="5">5 – Random Colors</option>
  <option value="6">6 – Sweep</option>
  <option value="7">7 – Dynamic</option>
  <option value="8">8 – Colorloop</option>
  <option value="9">9 – Rainbow</option>
  <option value="10">10 – Scan</option>
  <option value="11">11 – Dual Scan</option>
  <option value="12">12 – Fade</option>
  <option value="13">13 – Chase</option>
  <option value="14">14 – Chase Random</option>
  <option value="15">15 – Chase Rainbow</option>
  <option value="16">16 – Chase Flash</option>
  <option value="17">17 – Chase Flash Rnd</option>
  <option value="18">18 – Rainbow Runner</option>
  <option value="19">19 – Colorful</option>
  <option value="20">20 – Traffic Light</option>
  <option value="21">21 – Sweep Random</option>
  <option value="22">22 – Running 2</option>
  <option value="23">23 – Red &amp; Blue</option>
  <option value="24">24 – Stream</option>
  <option value="25">25 – Scanner</option>
  <option value="26">26 – Lighthouse</option>
  <option value="27">27 – Fireworks</option>
  <option value="28">28 – Rain</option>
  <option value="29">29 – Merry Christmas</option>
  <option value="30">30 – Fire Flicker</option>
  <option value="31">31 – Gradient</option>
  <option value="32">32 – Loading</option>
  <option value="41">41 – Fairy</option>
  <option value="42">42 – Two Dots</option>
  <option value="43">43 – Fairy Twinkle</option>
  <option value="44">44 – Running Dual</option>
  <option value="45">45 – Halloween</option>
  <option value="46">46 – Tri Chase</option>
  <option value="47">47 – Tri Wipe</option>
  <option value="48">48 – Tri Fade</option>
  <option value="49">49 – Lightning</option>
  <option value="50">50 – ICU</option>
  <option value="51">51 – Multi Comet</option>
  <option value="52">52 – Dual Scanner</option>
  <option value="53">53 – Stream 2</option>
  <option value="54">54 – Oscillate</option>
  <option value="55">55 – Pride 2015</option>
  <option value="56">56 – Juggle</option>
  <option value="57">57 – Palette</option>
  <option value="58">58 – Fire 2012</option>
  <option value="59">59 – Colorwaves</option>
  <option value="60">60 – BPM</option>
  <option value="61">61 – Fill Noise 8</option>
  <option value="62">62 – Noise 16 1</option>
  <option value="63">63 – Noise 16 2</option>
  <option value="64">64 – Noise 16 3</option>
  <option value="65">65 – Noise 16 4</option>
  <option value="66">66 – Colortwinkles</option>
  <option value="67">67 – Lake</option>
  <option value="68">68 – Meteor</option>
  <option value="69">69 – Meteor Smooth</option>
  <option value="70">70 – Railway</option>
  <option value="71">71 – Ripple</option>
  <option value="72">72 – Twinklefox</option>
  <option value="73">73 – Twinklecat</option>
  <option value="74">74 – Halloween Eyes</option>
  <option value="75">75 – Solid Pattern</option>
  <option value="76">76 – Solid Pattern Tri</option>
  <option value="77">77 – Spots</option>
  <option value="78">78 – Spots Fade</option>
  <option value="79">79 – Glitter</option>
  <option value="80">80 – Candle</option>
  <option value="81">81 – Fireworks Starburst</option>
  <option value="82">82 – Fireworks 1D</option>
  <option value="83">83 – Bouncing Balls</option>
  <option value="84">84 – Sinelon</option>
  <option value="85">85 – Sinelon Dual</option>
